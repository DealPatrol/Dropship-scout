# ── Database ─────────────────────────────────────────────────────────────────
# Any Postgres connection string. Neon (https://neon.tech) has a generous
# free tier — create a project/database and paste the connection string here.
# Tables are created automatically on first request.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# ── AI (optional) ────────────────────────────────────────────────────────────
# Powers AI product search and smarter catalog-builder prompt parsing.
# The discovery catalog, scores, planner and builder all work without it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects the hourly /api/cron/track job (set the same value in Vercel)
# Vercel sends it as: Authorization: Bearer <CRON_SECRET>.
# The route returns 503 when this variable is missing.
CRON_SECRET=your-random-secret-here

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Use a restricted server key with only the permissions this app needs.
STRIPE_SECRET_KEY=rk_test_replace_me
# Stripe Price for the recurring Dropship Scout Pro product.
STRIPE_PRO_PRICE_ID=price_replace_me
# Signing secret for POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ── Supplier data (optional; Pro) ────────────────────────────────────────────
# CJ Dropshipping API v2 access token. See docs/supplier-adapters.md.
CJ_API_ACCESS_TOKEN=replace-with-cj-access-token
# Override only for a compatible proxy or CJ sandbox.
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# ── Shopify ──────────────────────────────────────────────────────────────────
# Admin API version used for token validation and product creation.
SHOPIFY_API_VERSION=2026-07

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Optional AI product search and catalog prompt parsing
ANTHROPIC_API_KEY=sk-ant-replace-me

# Public application origin. Checkout return URLs and canonical links use
# NEXT_PUBLIC_SITE_URL, then NEXT_PUBLIC_APP_URL, then https://getdropshipscout.com.
# Production should set both public URLs to https://getdropshipscout.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required by GET /api/cron/track. Vercel sends:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string

# Stripe Billing (server-side)
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional live CJ Dropshipping adapter (Pro)
CJ_API_ACCESS_TOKEN=replace-with-cj-access-token
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Shopify Admin API (optional — the hosted storefront does not need it)
SHOPIFY_API_VERSION=2026-07

# ── Hosted storefront payments (Stripe Connect, test mode by default) ────────
# Leave STRIPE_LIVE_MODE unset or false. Live charges require a live key AND true.
STRIPE_LIVE_MODE=false
# Platform fee in basis points of merchandise. 500 = 5%.
PLATFORM_FEE_BPS=500
# Used only to reject listings that cannot clear an estimated card fee.
# The webhook uses the actual Stripe balance-transaction fee.
STRIPE_FEE_BPS=290
STRIPE_FEE_FIXED_CENTS=30
# Country for new Express recipient accounts (ISO 3166-1 alpha-2).
CONNECT_ACCOUNT_COUNTRY=US

# ── Supplier orders ──────────────────────────────────────────────────────────
# sandbox (default): CJ isSandbox=1, Printful draft (not confirmed),
# Printify order is not sent to production. live places and pays real orders.
SUPPLIER_ORDERS_MODE=sandbox

# Printful private token and the store that already has sync products.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_API_BASE_URL=https://api.printful.com

# Printify personal access token and shop id.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_API_BASE_URL=https://api.printify.com/v1

# Address used only to quote catalog shipping. Checkout re-quotes the customer address.
QUOTE_COUNTRY=US
QUOTE_REGION=CA
QUOTE_CITY=Los Angeles
QUOTE_POSTAL_CODE=90036
QUOTE_ADDRESS1=110 S Fairfax Ave
